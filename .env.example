# OracleDesk backend configuration. Copy to .env and fill in what you need.
# Every value here is empty or a local default. Never commit a filled-in .env.
# Variables are validated at startup (src/config/index.ts); a bad value stops
# the server with a message naming the variable.

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
# Postgres and Redis. These defaults match docker-compose.yml (local only,
# not secrets). Point them at your own servers for anything shared.
DATABASE_URL=postgresql://oracledesk:oracledesk@127.0.0.1:5433/oracledesk
REDIS_URL=redis://127.0.0.1:6379
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Auth ───────────────────────────────────────────────────────────────────
# JWT signing secret, at least 32 characters. Required in production. If
# empty in development, a random one is generated per process.
JWT_SECRET=
# Stellar secret seed (S…) that signs SEP-10 login challenges. Use a fresh
# key that holds no funds and is not the agent key. Required in production;
# generated per process in development if empty.
AUTH_SIGNING_SECRET=
# Domain shown in the challenge transaction (the frontend's host).
AUTH_HOME_DOMAIN=localhost
AUTH_WEB_AUTH_DOMAIN=
# Comma-separated G… addresses allowed to call admin endpoints.
ADMIN_ADDRESSES=

# ── Stellar network ────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract ids. Empty means "use src/generated/deployments.testnet.json".
MARKET_CORE_CONTRACT_ID=
TREASURY_CONTRACT_ID=
RESOLVER_CONTRACT_ID=
REASONING_REGISTRY_CONTRACT_ID=
USDC_CONTRACT_ID=

# Recipient of premium (daily pass) payments, G… or C…. Empty means the
# treasury contract, which makes subscription revenue agent trading capital.
# That is a product decision; see docs/STATUS.md.
PAYMENTS_RECIPIENT=
# Daily pass price in 7-decimal USDC base units (5000000 = 0.50 USDC).
DAILY_PASS_PRICE_RAW=5000000

# ── Agent execution ────────────────────────────────────────────────────────
# dry-run (default): every write is built and simulated, never signed or sent.
# live: writes are signed with AGENT_SECRET_KEY and submitted. Testnet only;
# the server refuses live mode on any other network.
CHAIN_EXECUTION_MODE=dry-run
# WARNING: testnet only. The agent's secret seed (S…). It controls treasury
# trades up to the treasury's caps. Never put a mainnet key here.
AGENT_SECRET_KEY=

# Resolution spec committed at market creation (signer mode). Empty signers
# means the agent account is the only signer.
RESOLUTION_SIGNERS=
RESOLUTION_THRESHOLD=1
RESOLUTION_DISPUTE_WINDOW_SECS=86400

# Event indexer (Stellar RPC getEvents poller).
INDEXER_ENABLED=true
INDEXER_POLL_MS=5000

# ── LLM providers (market and trace generation) ────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── IPFS (Pinata) ──────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ── Data sources ───────────────────────────────────────────────────────────
NEWSAPI_KEY=
FRED_API_KEY=

# ── LLM router (#157) ──────────────────────────────────────────────────────
# OpenAI or any OpenAI-compatible endpoint. The router can use them in a task
# policy even if Anthropic/Gemini are configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional JSON policy overriding some/all tasks, e.g.
# {"market_generation":[{"provider":"anthropic","model":"claude-sonnet-4-6",
#   "temperature":0.2,"maxTokens":4096,"timeoutMs":60000}]}
# Or a path to a JSON file. Missing tasks keep the built-in default policy.
LLM_POLICY=
LLM_POLICY_FILE=

# ── IPFS content store (#100) ──────────────────────────────────────────────
# Per-object cap and total Postgres budget for verified pinned bytes.
IPFS_CACHE_MAX_OBJECT_BYTES=262144
IPFS_CACHE_BUDGET_BYTES=268435456

# ── Transparency reports (#159) ────────────────────────────────────────────
REPORTS_ENABLED=false
REPORT_CRON=10 0 * * *
# dry-run: pin + persist, never publish on-chain. live: publish with the agent.
REPORT_MODE=dry-run
# URL placed in the report's method.doc field.
REPORT_METHOD_DOC=https://github.com/OracleDesk/oracledesk-backend/blob/main/docs/transparency-reports.md

# ── Treasury admin console (#156) ──────────────────────────────────────────
# Lifetime of a prepared unsigned transaction.
TREASURY_OP_TTL_SECONDS=3600
# Optional stricter backend policy for withdraw operations.
TREASURY_WITHDRAW_MIN_SIGNERS=0
